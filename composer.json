{
    "name": "bakewizard/slideshow",
    "description": "Slideshow plugin for BakeKit CMS",
    "license": "MIT",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "plugin",
        "image-gallery",
        "carousel",
        "bakekit"
    ],
    "require": {
        "php": ">=8.3",
        "cakephp/cakephp": "5.2.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.5 || ^11.1.3 || ^12.1"
    },
    "autoload": {
        "psr-4": {
            "Slideshow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slideshow\\Test\\": "tests/",
            "Slideshow\\Test\\Fixture\\": "tests/Fixture/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    }
}
